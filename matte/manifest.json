{
    "manifest_version": 3,
    "name": "Radical Matte",
    "version": "1.0.0",
    "description": "Copy a screenshot, click the icon, and get it back on your clipboard with your background, shadow and corners applied.",
    "permissions": ["clipboardRead", "clipboardWrite", "storage"],
    "action": {
        "default_popup": "popup.html",
        "default_title": "Prettify the screenshot on my clipboard",
        "default_icon": {
            "16": "icons/icon-16.png",
            "32": "icons/icon-32.png",
            "48": "icons/icon-48.png",
            "128": "icons/icon-128.png"
        }
    },
    "icons": {
        "16": "icons/icon-16.png",
        "32": "icons/icon-32.png",
        "48": "icons/icon-48.png",
        "128": "icons/icon-128.png"
    },
    "options_page": "index.html",
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Prettify the screenshot on the clipboard"
        }
    }
}
